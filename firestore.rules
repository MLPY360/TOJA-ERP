rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products catalog
    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }

    // Orders & order items
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    // Financial expenses & ad spend
    match /expenses/{expenseId} {
      allow read, write: if isAuthenticated();
    }

    // Partner capital & withdrawal ledgers
    match /partners/{partnerId} {
      allow read, write: if isAuthenticated();
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if isAuthenticated();
    }

    // Customer blacklist & fraud prevention
    match /blacklist/{phone} {
      allow read, write: if isAuthenticated();
    }

    // Inventory movements audit ledger
    match /inventory_movements/{movementId} {
      allow read, write: if isAuthenticated();
    }

    // Courier reconciliation batch settlements
    match /courier_settlements/{settlementId} {
      allow read, write: if isAuthenticated();
    }

    // Legacy Activity logs
    match /activityLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Structured Centralized System Telemetry Logs
    match /system_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Default safety catch-all for authenticated staff
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
