rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Products catalog
    match /products/{productId} {
      allow read, write: if isAuthenticated();
    }

    // Orders & order items
    match /orders/{orderId} {
      allow read, write: if isAuthenticated();
    }

    // Financial expenses & ad spend
    match /expenses/{expenseId} {
      allow read, write: if isAuthenticated();
    }

    // Partner capital & withdrawal ledgers
    match /partners/{partnerId} {
      allow read, write: if isAuthenticated();
    }

    match /withdrawals/{withdrawalId} {
      allow read, write: if isAuthenticated();
    }

    // Customer blacklist & fraud prevention
    match /blacklist/{phone} {
      allow read, write: if isAuthenticated();
    }

    // Inventory movements audit ledger
    match /inventory_movements/{movementId} {
      allow read, write: if isAuthenticated();
    }

    // Courier reconciliation batch settlements
    match /courier_settlements/{settlementId} {
      allow read, write: if isAuthenticated();
    }

    // Legacy Activity logs
    match /activityLogs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Structured Centralized System Telemetry Logs
    match /system_logs/{logId} {
      allow read, write: if isAuthenticated();
    }

    // Per-user AI CFO Chat history
    match /cfo_chats/{userId} {
      allow read, write: if isAuthenticated();
    }

    // Partner operations & accountability tasks
    match /partner_tasks/{taskId} {
      allow read, write: if isAuthenticated();
    }

    // E-Commerce Storefront: Back-in-Stock Waitlist
    match /waitlist/{waitlistId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // E-Commerce Storefront: Size Exchange Requests
    match /exchange_requests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isAuthenticated();
    }

    // E-Commerce Storefront: Promo Codes & Discounts
    match /promo_codes/{codeId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // E-Commerce Storefront: General Configuration (Shipping Rates, Free Shipping, Announcement Banner)
    match /store_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Default safety catch-all for authenticated staff
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
